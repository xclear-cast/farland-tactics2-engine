[configuration]
entry_symbol = "ft2_synth_library_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/libft2synth.so"
linux.release.x86_64 = "res://native/bin/libft2synth.so"
windows.debug.x86_64 = "res://native/bin/ft2synth.dll"
windows.release.x86_64 = "res://native/bin/ft2synth.dll"
macos.debug.arm64 = "res://native/bin/libft2synth.macos.arm64.dylib"
macos.release.arm64 = "res://native/bin/libft2synth.macos.arm64.dylib"
